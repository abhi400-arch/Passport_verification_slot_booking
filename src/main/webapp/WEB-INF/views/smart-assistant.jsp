<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="includes/header.jspf" %>
<!DOCTYPE html><html><head><title>Smart Assistant</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body>
<div class="container"><div class="hero"><div><h1>✨ Smart Passport Assistant</h1><p>Check your verification readiness and get intelligent appointment recommendations based on your preferred date, time and current slot availability.</p></div><div class="iconbox">🧠</div></div>
<div class="grid"><div class="stat"><div class="muted">Readiness score</div><div class="num">${readiness.score}%</div></div><div class="stat"><div class="muted">Completed checks</div><div class="num">${readiness.completed.size()}</div></div><div class="stat"><div class="muted">Items to review</div><div class="num">${readiness.missing.size()}</div></div></div>
<div class="card"><h2>Verification readiness</h2><c:if test="${not empty readiness.completed}"><p><strong>✓ Completed</strong></p><ul><c:forEach var="x" items="${readiness.completed}"><li>${x}</li></c:forEach></ul></c:if><c:if test="${not empty readiness.missing}"><p><strong>⚠ Review</strong></p><ul><c:forEach var="x" items="${readiness.missing}"><li>${x}</li></c:forEach></ul></c:if></div>
<div class="card"><h2>🎯 Smart slot recommendation</h2><p class="muted">Tell us your preference. The Java recommendation engine ranks the best available appointments.</p><form method="post"><div class="form-grid"><div class="field"><label>Preferred date</label><input type="date" name="preferredDate"></div><div class="field"><label>Preferred time</label><input type="time" name="preferredTime"></div></div><button class="btn" type="submit">Find Best Slots</button></form></div>
<c:if test="${not empty recommendations}"><div class="card"><h2>Recommended appointments</h2><div class="table-wrap"><table><tr><th>Rank</th><th>Date</th><th>Time</th><th>Remaining</th><th>Match</th><th>Why</th><th></th></tr><c:forEach var="r" items="${recommendations}" varStatus="s"><tr><td>🏆 ${s.index+1}</td><td>${r.slot.slotDate}</td><td>${r.slot.startTime} - ${r.slot.endTime}</td><td>${r.slot.capacity-r.slot.bookedCount}</td><td><span class="badge">${r.score}%</span></td><td>${r.reason}</td><td><a class="btn success small" href="${pageContext.request.contextPath}/app/slots">Book</a></td></tr></c:forEach></table></div></div></c:if>
<div class="card"><h2>Developer API</h2><p class="muted">Passport details are also available as authenticated JSON at <code>/api/passport</code>. Slot availability remains available at <code>/api/slots</code>.</p></div>
</div></body></html>
