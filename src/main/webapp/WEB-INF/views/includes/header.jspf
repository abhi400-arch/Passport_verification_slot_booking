<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="navbar">
  <a class="brand" href="${pageContext.request.contextPath}/home">🛂 Passport<span>Verify</span></a>
  <div class="navlinks">
    <c:choose>
      <c:when test="${not empty sessionScope.user}">
        <c:choose>
          <c:when test="${sessionScope.user.role == 'ADMIN'}">
            <a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a>
            <a href="${pageContext.request.contextPath}/admin/slots">Slots</a>
            <a href="${pageContext.request.contextPath}/admin/bookings">Bookings</a>
            <a href="${pageContext.request.contextPath}/admin/users">Users</a>
            <a href="${pageContext.request.contextPath}/admin/verify-pass">🛡️ Gate Scanner</a>
            <a href="${pageContext.request.contextPath}/admin/analytics">📊 Analytics</a>
          </c:when>
          <c:otherwise>
            <a href="${pageContext.request.contextPath}/app/dashboard">Dashboard</a>
            <a href="${pageContext.request.contextPath}/app/passport">Profile</a>
            <a href="${pageContext.request.contextPath}/app/documents">📁 Document Vault</a>
            <a href="${pageContext.request.contextPath}/app/pass">🎫 Digital Pass</a>
            <a href="${pageContext.request.contextPath}/app/waitlist">⚡ Tatkal Waitlist</a>
            <a href="${pageContext.request.contextPath}/app/slots">Book Slot</a>
            <a href="${pageContext.request.contextPath}/app/bookings">My Bookings</a>
            <a href="${pageContext.request.contextPath}/app/smart-assistant">✨ Assistant</a>
            <a href="${pageContext.request.contextPath}/app/notifications" title="Notifications">
              🔔 Alerts <span id="notifBadge" class="nav-badge" data-api-url="${pageContext.request.contextPath}/api/notifications/count" style="display:none;">0</span>
            </a>
          </c:otherwise>
        </c:choose>
        <a href="${pageContext.request.contextPath}/logout">Logout</a>
      </c:when>
      <c:otherwise>
        <a href="${pageContext.request.contextPath}/login">Login</a>
        <a href="${pageContext.request.contextPath}/register">Register</a>
      </c:otherwise>
    </c:choose>
  </div>
</nav>
<script src="${pageContext.request.contextPath}/assets/js/app.js"></script>
